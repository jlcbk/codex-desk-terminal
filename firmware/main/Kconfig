# CodexDT dev net 配置（P5.2 前半：连接稳定性交付）
#
# 背景：整机集成期间 "Wi-Fi 空闲 RX 停滞 → 周期断链" 的根因在 Bridge 侧
# relay 上游 socket 10s 超时（scripts/bridge_serve_mock.py，已修），设备侧
# esp_wifi 从未停滞（同证据窗口 ping→pong RTT max 229ms）。本开关只用于
# A/B 固化 "稳定在线的默认省电配置"，不启用自动 Light Sleep / modem-sleep
# 精细策略（CONNECTED_IDLE 的精细联动设计归 P5.2 后半 + P6.1 仪器实测）。
menu "CodexDT dev net (P5.2)"

    config CDT_WIFI_PS_MODE
        int "WiFi STA 省电模式（0=NONE 1=MIN_MODEM 2=MAX_MODEM）"
        range 0 2
        default 1
        help
            dev_net_start 在 esp_wifi_start 后调用 esp_wifi_set_ps 应用。
            IDF 默认即 MIN_MODEM（default 1 = 保持现网行为可对照）。
            NONE=全时射频在线（稳定优先，功耗未测，归 P6.1）。
            MAX_MODEM=每 listen_interval 唤醒一次（listen_interval 默认
            3 beacon，未改），只作 A/B 数据点，不作为默认。

    config CDT_TZ_OFFSET_MIN
        int "本地时区偏移（分钟，东半球为正；中国=480）"
        range -840 840
        default 480
        help
            顶栏时钟 = 快照 generated_at_ms（UTC）+ 该偏移，仅显示换算，
            不参与任何状态判断（协议时间语义不变）。模拟器固定 0（确定性）。

    # ------------------------------------------------------------------
    # ZC9（A9，2026-09-13）追加块：Wi-Fi 空闲动态降档（P5.2 后半）。
    # 决策单源 firmware/main/app_power_idle.c；档位应用 dev_net_set_idle_ps。
    # 与 ZC11 的 CDT_TRANSPORT_SEL 块错开区域，互不包含。
    # ------------------------------------------------------------------
    config CDT_IDLE_DOWNGRADE_MIN
        int "Wi-Fi 空闲降档阈值（分钟：无快照/按键持续该时长 → MAX_MODEM）"
        range 1 60
        default 5
        help
            app 主循环周期评估：无合法新快照且无按键持续达到该阈值 → 切
            WIFI_PS_MAX_MODEM；任何新快照/按键 → 立即回 MIN_MODEM（数据
            链路优先红线）。迟滞：切 MAX 后至少保持 60s 才允许再评估。
            仅在 CDT_WIFI_PS_MODE=1（MIN 基线，产品默认）时编译启用；
            从未收到合法快照不降档（首包等待期保持 MIN）。量化电流实测
            归 P5.4。

    # ------------------------------------------------------------------
    # ZC11（A11，2026-09-13）追加块：产品主流程传输选择。与 ZC9/ZC10 的
    # Kconfig 追加块错开区域，本块独立成段；契约真源 protocol/transport.md。
    # ------------------------------------------------------------------
    config CDT_TRANSPORT_SEL
        int "传输方式选择（0=WiFi/WSS 1=BLE peripheral）"
        range 0 1
        default 0
        help
            产品主流程同一固件二选一编译进运行路径（Kconfig 编译期选定，
            运行期不再切换；transport.md §1「同一时刻只有一个活动 transport」）。
            0=WiFi/WSS（默认，现网行为零变化）：dev_net 起 WiFi STA，
            cdt_wss_client 连 Bridge /v1/state（TLS+CA 验链+SPKI pin+token，
            凭据经 dev_net_config.h）；BLE 组件照常编译入 archive 但不启动、
            不链接其运行路径。
            1=BLE peripheral：不启动 WiFi/WSS；cdt_ble_peripheral 以冻结
            UUID（transport.md §2.1）广播（设备名 CodexDT 在 scan response），
            RX 分片写入→重组器→CRC32→经与 WSS 同一 app_inbox 管线下游
            （互斥/优先提醒槽语义不变）；ACK/NACK 由组件按上层三值结果经
            TX Notify 回发（§3.4）。无 WiFi 凭据亦可构建（CDT_DEVNET_OFFLINE
            组合同样可用）。配对为 LE Secure Connections+数字比较+绑定
            （§2.3）；KEY 长按确认接线与配对/MTU/吞吐为 P3.4 B 系列真机项，
            未实测项不标已验证。

endmenu
