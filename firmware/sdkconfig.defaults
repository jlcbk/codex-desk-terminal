# P4.2 sdkconfig.defaults — 关键配置按 P4.1a 真机验证值锁定
# 证据：artifacts/idf/sdkconfig-significant-diff.txt、artifacts/board/p41c-summary.md
# （16MB Flash QIO、PSRAM Octal 80MHz、UART0 主控制台 + USB-Serial-JTAG secondary、CPU 160MHz）
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 整机集成：StateStore（2×17KiB scratch）+ 16KiB 快照收件槽放 PSRAM 静态区
# （内部 DRAM 放不下：全量构建后 dram0.bss 溢出 ~25KB；EXT_RAM_BSS_ATTR）。
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# ZC9（P5.2 后半，2026-09-13）：DFS 顶频取 CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ
# （CONFIG_PM_DFS_INIT_AUTO），主频随之 160→240（S3 顶频，性能不因 PM 回退；
# 空闲时 DFS 自动降档至 XTAL 40MHz + tickless 自动 Light Sleep）。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000

# wqy 点阵落地（A2，2026-09-11）：全量 wqy 单字体 ~1.8MB 进 app，factory 1M 不足。
# 16MB flash、无 OTA 诉求（A0 授权）→ 自定义分区表 factory 1M→4M（约 30% 余量）。
# 整机集成（A3+A4，2026-09-11）：全量构建加入 WiFi+wss+TLS+NimBLE 后 app 超 4M
# → factory 4M→12M（16MB flash 内，仍无 OTA）。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 整机集成：BLE（NimBLE）编译参与（transport 组件 ble_peripheral.c），本集成
# 用 WSS、不启动 BLE（同一时刻仅一个活动 transport，transport.md §1）。
# 数值与 examples/transport_skeleton（A4 编译验证基线）一致。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# 整机集成真机（1301）实测：内部 heap 起步仅 ~113KB，wifi+lwip+websocket 常驻后
# mbedTLS ssl_setup（RSA-2048 握手需 ~48KB 内部块）分配失败
# （MBEDTLS_ERR_SSL_SETUP_FAILED/-0x7F00，见 artifacts/board/integration/serial_boot.log）
# → mbedTLS 缓冲与 wifi/lwip 动态缓冲优先 PSRAM。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# P5.2 前半（连接稳定性，2026-09-11）：WiFi STA 省电模式显式化（0=NONE 1=MIN 2=MAX）。
# IDF 默认 MIN_MODEM；A/B 数据与默认值理由见 artifacts/board/p52/report.md。
# 注意：CONNECTED_IDLE 的 modem-sleep 精细联动归 P5.2 后半；功耗实测归 P6.1。
CONFIG_CDT_WIFI_PS_MODE=1

# ZC9（P5.2 后半，2026-09-13）：CPU 电源管理 —— PM + tickless idle + DFS 自动档。
# CONFIG_PM_DFS_INIT_AUTO（IDF 5.5.5 esp_pm/pm_impl.c）：启动即配 DFS，
# 顶频 = CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ（240，见上），底频 = XTAL 40MHz；
# light_sleep_enable 保持 false（自动 Light Sleep 不在本轮范围，见 P5.4）。
# FREERTOS_USE_TICKLESS_IDLE：空闲时按最近事件截止时间跳过 tick，CPU 停在
# waiti，不再 1ms tick 空转。
# 已知开发期副作用（仅日志观感）：DFS 下 UART 控制台可能出乱码；LVGL 时基
# 走 esp_timer（LV_TICK_CUSTOM）不受影响；SPI Master 传输期经总线锁禁睡/
# 锁频，LCD 刷新不受 DFS 影响。量化电流实测归 P5.4（仪器未到位）。
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y
