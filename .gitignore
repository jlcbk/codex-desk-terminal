# 构建产物与临时证据
artifacts/
build/
out/
__pycache__/
*.pyc
.DS_Store

# 第三方锁定依赖（由 scripts/ 下脚本按 VERSIONS.md 的 tag/sha256 拉取，不入库）
vendor/
third_party/
# 例外：锁定源文件与许可文本入库（字体 BDF/OTF + COPYING，复现性与合规）
!third_party/dl/
!third_party/dl/wqy-bitmapsong/
!third_party/dl/wqy-bitmapsong/**


# 凭证与本地配置（凭证不进 State、fixtures 或日志）
*.pem
*.key
config/local/
.env

# 协议探针临时输出（脱敏后的样本才允许入库 docs/proto-samples/）
/tmp-probe/

# IDF component manager 生成缓存（由 dependencies.lock 锁定版本，本体不入库）
firmware/examples/*/managed_components/
firmware/managed_components/
# 设备联调凭据（模板入库，真值不入库）
firmware/main/dev_net_config.h
